    "url": "https://github.com/bshal/snapdb.git"
  },
  "keywords": [
    "database",
    "json",
    "nodejs",
    "indexing",
    "async",
    "embedded",
    "mongodb-query",
    "zero-dependency"
  ],
  "author": "Bishal Chettri",
  "license": "MIT",
  "homepage": "https://github.com/bshal/snapdb#readme",
  "devDependencies": {
    "jest": "^29.7.0"
  },
  "jest": {
    "setupFiles": [
      "<rootDir>/tests/setup.js"
    ]
  },
  "types": "index.d.ts",
  "files": [
    "src",
    "index.d.ts",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  }
